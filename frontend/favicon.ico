<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="msGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#1d4ed8"/>
    </linearGradient>
    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#2563eb" stop-opacity="0.2"/>
    </linearGradient>
  </defs>
  <!-- Background Rounded Shield -->
  <rect width="64" height="64" rx="16" fill="url(#msGrad)"/>
  
  <!-- Outer Sphere Orbital Rings -->
  <ellipse cx="32" cy="32" rx="24" ry="10" fill="none" stroke="url(#ringGrad)" stroke-width="2.5" transform="rotate(-25 32 32)"/>
  <circle cx="32" cy="32" r="22" fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="1.5"/>
  
  <!-- Central Brand M Glyph -->
  <path d="M20 44 L20 22 L27 34 L32 26 L37 34 L44 22 L44 44" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Small North Star Accent -->
  <circle cx="46" cy="18" r="2.5" fill="#facc15"/>
</svg>
