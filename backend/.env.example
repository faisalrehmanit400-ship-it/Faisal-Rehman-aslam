# ==============================================================================
# MarketSphere Marketplace Backend - Environment Configuration
# Copy this file to .env and configure your local credentials
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=marketsphere_db
DB_PORT=3306

# JSON Web Token Secret
JWT_SECRET=marketsphere_ultra_secure_jwt_secret_token_2026_x89!
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend Client (VS Code Live Server or Vite dev)
CLIENT_URL=http://127.0.0.1:5500
